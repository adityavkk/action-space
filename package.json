{
  "name": "action-space",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/src/server.js",
    "dev": "tsx src/server.ts",
    "test": "vitest run",
    "test:kubernetes:live": "node dist/examples/kubernetes-live.js",
    "test:compose": "bash scripts/test-compose.sh",
    "test:compose:mcp": "ACTION_SPACE_TEST_MCP=1 bash scripts/test-compose.sh",
    "setup:executor": "npm ci --prefix providers/executor --ignore-scripts --no-audit --no-fund",
    "check": "tsc --noEmit",
    "demo": "tsx examples/journeys.ts",
    "format": "prettier --write --ignore-unknown src test examples scripts providers config README.md package.json tsconfig.json vitest.config.ts compose.yaml"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@kubernetes/client-node": "2.0.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "ajv": "8.20.0",
    "e2b": "2.49.1",
    "effect": "4.0.0-beta.107",
    "ipaddr.js": "2.5.0",
    "json-schema-to-typescript": "15.0.4",
    "pg": "8.16.3",
    "quickjs-emscripten": "0.32.0",
    "typescript": "5.9.3",
    "undici": "7.29.1"
  },
  "devDependencies": {
    "@effect/vitest": "4.0.0-beta.107",
    "@types/node": "24.10.1",
    "@types/pg": "8.15.6",
    "node": "24.21.0",
    "prettier": "3.6.2",
    "tsx": "4.20.6",
    "vitest": "4.1.0"
  }
}
