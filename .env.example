# Optional: copy to .env. No credentials belong in this file.
COMPOSE_PROJECT_NAME=action-space
ACTION_SPACE_PORT=3000
# Use 0 for a Docker-assigned port; find it with docker compose port action-space 3000.
# ACTION_SPACE_PORT=0
# Config is mounted read-only; cloud adapters are opt-in and need explicit credentials/overrides.
ACTION_SPACE_CONFIG_FILE=./config/local.json
# Optional collector: docker compose --profile observability up --build --wait
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel:4318
